mysql:
    image: 'mysql/mysql-server:8.0'
    container_name: MySQL
    ports:
        - '${FORWARD_DB_PORT:-3306}:3306'
    environment:
        MYSQL_ROOT_PASSWORD: '${DB_PASSWORD}'
        MYSQL_ROOT_HOST: "%"
        MYSQL_DATABASE: '${DB_DATABASE}'
        MYSQL_USER: '${DB_USERNAME}'
        MYSQL_PASSWORD: '${DB_PASSWORD}'
        MYSQL_ALLOW_EMPTY_PASSWORD: 1
    volumes:
        - 'desk-mysql:/var/lib/mysql'
        - './vendor/postboxcms/desk/database/mysql/create-postbox-database.sh:/docker-entrypoint-initdb.d/10-create-postbox-database.sh'
    networks:
        - desk
    healthcheck:
        test: ["CMD-SHELL", 'if [ -z "${DB_PASSWORD}" ]; then mysqladmin ping -h localhost; else mysqladmin -u"${DB_USERNAME}" -p"${DB_PASSWORD}" ping -h localhost; fi']
        interval: 10s
        timeout: 5s
        retries: 10
